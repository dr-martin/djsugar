<Template>

  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>WaveformsContainer</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <RequiresStem>true</RequiresStem>
            <Layout>vertical</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/controls/button_2state_persist.xml">
                <SetVariable name="TooltipId">show_stem_controls</SetVariable>
                <SetVariable name="ObjectName">StemControlsToggle</SetVariable>
                <SetVariable name="Size">26f,52f</SetVariable>
                <SetVariable name="BtnSize"></SetVariable>
                <SetVariable name="ConfigKey">[Skin],show_stem_controls</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>

          <!-- DJ Sugar: shared beatmatching view. Deck 1 (red) and Deck 2
               (green) occupy exactly the same pixels. QStackedLayout StackAll
               keeps both waveform viewers visible. -->
          <WidgetGroup>
            <ObjectName>DJSugarSharedWaveform</ObjectName>
            <Layout>vertical</Layout>
            <Size>100me,40me</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>DJSugarWaveformOverlay</ObjectName>
                <Layout>stacked</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <Template src="skins:LateNight/waveform.xml">
                    <SetVariable name="ChanNum">1</SetVariable>
                    <SetVariable name="SignalColor">#ff2020</SetVariable>
                    <SetVariable name="BgColorWaveform">#000000</SetVariable>
                    <SetVariable name="Highlight">[Skin],show_4decks</SetVariable>
                  </Template>
                  <Template src="skins:LateNight/waveform.xml">
                    <SetVariable name="ChanNum">2</SetVariable>
                    <SetVariable name="SignalColor">#20ff40</SetVariable>
                    <SetVariable name="BgColorWaveform">#00000000</SetVariable>
                    <SetVariable name="Highlight">[Skin],show_4decks</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

              <!-- One zoom fader for the shared view. Channel 2 is mirrored by
                   the Hercules script, so both decks always use the same scale. -->
              <WidgetGroup>
                <ObjectName>DJSugarWaveformZoomRow</ObjectName>
                <Layout>horizontal</Layout>
                <Size>100me,22f</Size>
                <Children>
                  <Label><Size>20f,20f</Size><Text>-</Text><Alignment>center</Alignment></Label>
                  <SliderComposed>
                    <ObjectName>DJSugarSharedWaveformZoom</ObjectName>
                    <Size>me,20f</Size>
                    <TooltipId>waveform_display</TooltipId>
                    <Handle scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="SliderScheme"/>/sliders/knob_crossfader.svg</Handle>
                    <Slider scalemode="STRETCH">skins:LateNight/<Variable name="SliderScheme"/>/sliders/slider_crossfader.svg</Slider>
                    <Horizontal>true</Horizontal>
                    <Connection>
                      <ConfigKey>[Channel1],waveform_zoom</ConfigKey>
                    </Connection>
                  </SliderComposed>
                  <Label><Size>20f,20f</Size><Text>+</Text><Alignment>center</Alignment></Label>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>1f,1min</Size></WidgetGroup>

          <Template src="skins:LateNight/controls/button_2state_persist.xml">
            <SetVariable name="TooltipId">show_beatgrid_controls</SetVariable>
            <SetVariable name="ObjectName">BeatgridControlsToggle</SetVariable>
            <SetVariable name="Size">26f,52f</SetVariable>
            <SetVariable name="BtnSize"></SetVariable>
            <SetVariable name="ConfigKey">[Skin],show_beatgrid_controls</SetVariable>
          </Template>

          <WidgetGroup>
            <Size>2f,1min</Size>
            <Connection>
              <ConfigKey>[Master],skin_settings</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
        <Connection>
          <ConfigKey>[Master],skin_settings</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </WidgetGroup><!-- WaveformsContainer -->

    </Children>
  </WidgetGroup>
</Template>
