/*
 * DJ Sugar Android light readability override
 *
 * Goal: improve daylight / phone-screen legibility without changing font sizes
 * yet. Waveform canvases and VU meters intentionally stay dark because their
 * coloured graphics depend on a dark background.
 */

/* Main surfaces */
#SkinContainer,
#ToolBar,
#MainControls,
#HeadphoneControls,
#MixerDecks,
#MixerContainer,
#Deck1, #DeckCompact1, #DeckMini1,
#Deck2, #DeckCompact2, #DeckMini2,
#Deck3, #DeckCompact3, #DeckMini3,
#Deck4, #DeckCompact4, #DeckMini4,
#Sampler, #SamplerMini,
#PreviewDeck,
#LibrarySingleton,
#LibraryFeatureControls,
#SearchLineBox,
#LibExpandBox,
#SidebarBox,
#SidebarCoverSplitter,
#LibrarySplitter,
WLibrary {
  background-color: #e4e7eb;
  color: #17191c;
  border-color: #b5bbc2;
}

/* Library / YouTube / Tracks: highest-priority readability area */
WTrackTableView,
WLibrarySidebar,
WLibraryTextBrowser,
WSearchLineEdit,
WTrackTableView QTableView,
WTrackTableView QAbstractItemView {
  background-color: #f7f8fa;
  alternate-background-color: #eceff2;
  color: #101214;
  selection-background-color: #c7ddf2;
  selection-color: #101214;
  border-color: #aab0b7;
}

WTrackTableView::item:selected,
WLibrarySidebar::item:selected,
WLibraryTextBrowser::item:selected {
  background-color: #c7ddf2;
  color: #101214;
}

WTrackTableView::item:hover,
WLibrarySidebar::item:hover {
  background-color: #ddeaf6;
  color: #101214;
}

/* Column headings */
WTrackTableViewHeader,
WTrackTableViewHeader::section,
QHeaderView,
QHeaderView::section {
  background-color: #d8dde2;
  color: #202327;
  border-color: #aeb4ba;
}

/* Search fields and ordinary text-entry controls */
WSearchLineEdit,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QAbstractSpinBox {
  background-color: #ffffff;
  color: #111315;
  selection-background-color: #bcd8f0;
  selection-color: #111315;
  border-color: #9ea5ad;
}

/* Make light-on-dark labels readable after the panel background is lightened. */
WLabel,
WNumber,
WNumberPos,
WKey,
WTime,
WTrackProperty,
WRecordingDuration,
#LibraryFeatureControls QLabel,
#LibraryFeatureControls QRadioButton,
#LibraryFeatureControls QPushButton,
#MainMenu,
#MainMenu::item {
  color: #1b1e22;
}

/* Keep loaded-track metadata strongly legible. */
#TitleText, #TitleTextSmall,
#ArtistText, #ArtistTextSmall,
#BpmText, #BpmTextSmall,
#KeyText, #KeyTextSmall,
#DurationText,
#PlayPositionText, #PlayPositionTextSmall,
#RateText, #RateRangePrefix {
  color: #111315;
}

/* Menus / tooltips / popup lists */
QMenu,
QMenu::item,
QToolTip,
WLibrarySidebar QMenu,
WLibraryTextBrowser QMenu,
WTrackMenu,
WTrackMenu QMenu,
WTrackTableViewHeader QMenu,
WSearchLineEdit QAbstractItemView,
QComboBox QAbstractItemView {
  background-color: #f7f8fa;
  color: #151719;
  selection-background-color: #c7ddf2;
  selection-color: #101214;
  border-color: #aab0b7;
}

/* Simple neutral buttons; icon-bearing buttons keep their existing images. */
#LibraryFeatureControls QPushButton,
QDialog QPushButton,
QMessageBox QPushButton {
  background-color: #eceff2;
  color: #151719;
  border: 1px solid #aab0b7;
  border-radius: 3px;
}

/* Preferences and dialogs should not inherit the phone's dark palette. */
QDialog,
QMessageBox,
QDialog QLabel,
QDialog QGroupBox,
QDialog QCheckBox,
QDialog QRadioButton,
QDialog QTabWidget,
QDialog QTabBar {
  background-color: #f2f4f6;
  color: #17191c;
}

/* Keep audio visualisation surfaces dark for contrast. */
#WaveformsContainer,
#WaveformsFrame,
#WaveformBox1,
#WaveformBox2,
#WaveformBox3,
#WaveformBox4,
#OverviewBox,
#OverviewBoxMini,
#VuMeterBox,
#VuMeterBoxMain,
#VuMeterBoxMainSingle,
#LatencyMeterBox {
  background-color: #151719;
}


/* -------------------------------------------------------------------------
 * Preferences: force a complete light palette.
 *
 * Some preferences pages are ordinary Qt widgets rather than skin widgets.
 * On Android they can inherit white foreground colours from the dark system
 * palette while our first readability pass already made their backgrounds
 * light. Scope the override to DlgPreferencesDlg so every page has a known,
 * high-contrast foreground/background pair.
 * ------------------------------------------------------------------------- */
#DlgPreferencesDlg,
#DlgPreferencesDlg QWidget,
#DlgPreferencesDlg QFrame,
#DlgPreferencesDlg QStackedWidget,
#DlgPreferencesDlg QScrollArea,
#DlgPreferencesDlg QAbstractScrollArea,
#DlgPreferencesDlg QAbstractScrollArea QWidget {
  background-color: #f2f4f6;
  color: #181b1f;
}

/* Left-hand preferences navigation. */
#DlgPreferencesDlg #contentsTreeWidget,
#DlgPreferencesDlg #contentsTreeWidget::viewport {
  background-color: #ffffff;
  color: #1a1d21;
  alternate-background-color: #f1f3f5;
  selection-background-color: #8fd33f;
  selection-color: #102000;
  border: 1px solid #aeb4ba;
  outline: none;
}
#DlgPreferencesDlg #contentsTreeWidget::item {
  color: #1a1d21;
  background-color: transparent;
}
#DlgPreferencesDlg #contentsTreeWidget::item:selected {
  color: #102000;
  background-color: #8fd33f;
}
#DlgPreferencesDlg #contentsTreeWidget::item:hover:!selected {
  color: #15181b;
  background-color: #e4efda;
}

/* Page text and section labels. */
#DlgPreferencesDlg QLabel,
#DlgPreferencesDlg QGroupBox,
#DlgPreferencesDlg QCheckBox,
#DlgPreferencesDlg QRadioButton {
  background-color: transparent;
  color: #1c1f23;
}
#DlgPreferencesDlg QLabel:disabled,
#DlgPreferencesDlg QGroupBox:disabled,
#DlgPreferencesDlg QCheckBox:disabled,
#DlgPreferencesDlg QRadioButton:disabled {
  color: #686e75;
}

/* Text fields, selectors and number fields. */
#DlgPreferencesDlg QLineEdit,
#DlgPreferencesDlg QComboBox,
#DlgPreferencesDlg QSpinBox,
#DlgPreferencesDlg QDoubleSpinBox,
#DlgPreferencesDlg QAbstractSpinBox,
#DlgPreferencesDlg QTextEdit,
#DlgPreferencesDlg QPlainTextEdit {
  background-color: #ffffff;
  color: #121416;
  selection-background-color: #b8d7f0;
  selection-color: #101214;
  border: 1px solid #9299a1;
}
#DlgPreferencesDlg QLineEdit:disabled,
#DlgPreferencesDlg QComboBox:disabled,
#DlgPreferencesDlg QSpinBox:disabled,
#DlgPreferencesDlg QDoubleSpinBox:disabled,
#DlgPreferencesDlg QAbstractSpinBox:disabled,
#DlgPreferencesDlg QTextEdit:disabled,
#DlgPreferencesDlg QPlainTextEdit:disabled {
  background-color: #e9ecef;
  color: #5e646b;
  border-color: #b8bdc3;
}

/* Native item views used by Library, Controllers and other preference pages. */
#DlgPreferencesDlg QTreeView,
#DlgPreferencesDlg QListView,
#DlgPreferencesDlg QTableView,
#DlgPreferencesDlg QAbstractItemView {
  background-color: #ffffff;
  alternate-background-color: #f0f2f4;
  color: #171a1e;
  selection-background-color: #c7ddf2;
  selection-color: #101214;
  border-color: #aab0b7;
}
#DlgPreferencesDlg QTreeView::item:selected,
#DlgPreferencesDlg QListView::item:selected,
#DlgPreferencesDlg QTableView::item:selected {
  background-color: #c7ddf2;
  color: #101214;
}

/* Headers and tabs. */
#DlgPreferencesDlg QHeaderView,
#DlgPreferencesDlg QHeaderView::section {
  background-color: #d9dde1;
  color: #202327;
  border-color: #aeb4ba;
}
#DlgPreferencesDlg QTabWidget::pane {
  background-color: #f2f4f6;
  border: 1px solid #aeb4ba;
}
#DlgPreferencesDlg QTabBar::tab {
  background-color: #dfe3e7;
  color: #202327;
  border: 1px solid #aeb4ba;
  padding: 3px 7px;
}
#DlgPreferencesDlg QTabBar::tab:selected {
  background-color: #ffffff;
  color: #101214;
}

/* Buttons: dark text even when the Android palette says otherwise. */
#DlgPreferencesDlg QPushButton,
#DlgPreferencesDlg QToolButton,
#DlgPreferencesDlg QDialogButtonBox QPushButton {
  background-color: #f4f5f6;
  color: #17191c;
  border: 1px solid #9299a1;
  border-radius: 2px;
}
#DlgPreferencesDlg QPushButton:disabled,
#DlgPreferencesDlg QToolButton:disabled,
#DlgPreferencesDlg QDialogButtonBox QPushButton:disabled {
  background-color: #e5e8eb;
  color: #747a81;
  border-color: #bcc1c6;
}

/* Popup lists inherit their own palette on Android, so pin those too. */
#DlgPreferencesDlg QComboBox QAbstractItemView {
  background-color: #ffffff;
  color: #171a1e;
  selection-background-color: #c7ddf2;
  selection-color: #101214;
}

/* Global safety net for standard light controls outside Preferences. */
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QAbstractSpinBox:disabled {
  background-color: #e9ecef;
  color: #5e646b;
}
QListView,
QTreeView,
QTableView {
  color: #171a1e;
}


/* -------------------------------------------------------------------------
 * Android phone readability: approximately 125% larger text/touch targets.
 * Keep the waveform canvas dark and give the library enough row height to be
 * comfortable on a touchscreen.
 * ------------------------------------------------------------------------- */

/* Small labels: 10-11 px upstream -> 13-14 px here */
#KnobLabel,
#FxKnobLabel,
#FxButtonLabel,
#RateRangeText,
#LatencyLabel {
  font-size: 13px;
}

WPushButton,
#LibraryFeatureControls QPushButton,
#RecDuration[highlight="0"],
#RecDuration[highlight="1"] {
  font-size: 14px;
}

/* 12-13 px upstream -> 15-16 px */
#RateRangePrefix,
#RecDuration[highlight="2"],
#SamplerTitleMini,
#EQKillButton,
#SamplerBpmMini,
#PreviewBPM,
#LibraryFeatureControls QRadioButton {
  font-size: 15px;
}

WKey,
WEffectSelector,
WEffectSelector QAbstractScrollArea,
WEffectChainPresetSelector,
WEffectChainPresetSelector QAbstractScrollArea,
#fadeModeCombobox,
#fadeModeCombobox QAbstractScrollArea,
#LibraryFeatureControls QLabel,
#SkinSettingsButton,
#SkinSettingsNumToggle,
#SkinSettingsMixerToggle,
#SkinSettingsText {
  font-size: 16px;
}

/* 14 px upstream -> 17 px */
#PlayPositionTextSmall,
#DurationText,
#RateText,
#SamplerBpm,
#MicAuxLabel,
#MicAuxLabelUnconfigured,
#PreviewTitle,
#PreviewLabel,
WBeatSpinBox,
#spinBoxTransition {
  font-size: 17px;
}

/* Important deck/library information */
#TitleTextSmall,
#ArtistTextSmall,
#PlayPositionText,
#BpmText,
#BpmTextSmall,
#FxUnitLabel,
#SamplerTitle,
WTrackPropertyEditor,
WTime,
WRecordingDuration {
  font-size: 20px;
}

#ArtistText,
#TitleText {
  font-size: 22px;
}

/* Library and YouTube browser: larger rows and readable text. */
WTrackTableView,
WLibrarySidebar,
WLibraryTextBrowser,
WSearchLineEdit,
WTrackTableView QTableView,
WTrackTableView QAbstractItemView {
  font-size: 16px;
}

WTrackTableView::item,
WLibrarySidebar::item,
WLibraryTextBrowser::item {
  padding: 4px 5px;
}

WTrackTableViewHeader,
WTrackTableViewHeader::section,
QHeaderView,
QHeaderView::section {
  font-size: 15px;
  padding: 4px 5px;
}

WSearchLineEdit,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QAbstractSpinBox {
  font-size: 16px;
  min-height: 28px;
}

QMenu,
QMenu::item,
QToolTip {
  font-size: 15px;
}
QMenu::item {
  padding: 5px 10px;
}

#LibraryFeatureControls QPushButton {
  min-height: 28px;
  padding-left: 8px;
  padding-right: 8px;
}


/* =========================================================================
 * FINAL ANDROID READABILITY PASS
 *
 * LateNight's original PaleMoon rules use highly-specific selectors for a
 * dark skin. The Android skin is light, so repeat the important selectors
 * here with equal/higher specificity. This prevents pale text from surviving
 * on light panels and makes the complete phone UI more consistent.
 * ========================================================================= */

/* Track table: strongest readability defaults, including delegate colors. */
#LibrarySingleton WTrackTableView,
#LibraryContainer WTrackTableView,
WLibrary WTrackTableView {
  background-color: #ffffff;
  alternate-background-color: #edf1f4;
  color: #0d1013;
  selection-background-color: #b8d7f0;
  selection-color: #0b0d0f;
  qproperty-focusBorderColor: #26323c;
  qproperty-trackPlayedColor: #3f474f;
  qproperty-trackMissingColor: #a00020;
  qproperty-dropIndicatorColor: #8a3c00;
  outline: 1px solid #66717b;
}
#DlgMissing WTrackTableView {
  qproperty-trackMissingColor: #a00020;
}
#LibrarySingleton WTrackTableView::item:selected,
#LibraryContainer WTrackTableView::item:selected,
WLibrary WTrackTableView::item:selected {
  background-color: #b8d7f0;
  color: #0b0d0f;
}
#LibrarySingleton WTrackTableView::item:!selected:focus,
#LibraryContainer WTrackTableView::item:!selected:focus,
WLibrary WTrackTableView::item:!selected:focus {
  background-color: #e0eef9;
  color: #0b0d0f;
  outline: 1px solid #40515f;
}
#LibrarySingleton WTrackTableView QCheckBox:focus,
#LibraryContainer WTrackTableView QCheckBox:focus {
  outline: 1px solid #40515f;
}

/* Library tree, text pages and header. */
#LibraryContainer WLibrarySidebar,
#LibraryContainer WLibraryTextBrowser {
  background-color: #ffffff;
  alternate-background-color: #edf1f4;
  color: #111417;
  selection-background-color: #b8d7f0;
  selection-color: #0b0d0f;
}
#LibraryContainer WLibrarySidebar::item:selected {
  background-color: #b8d7f0;
  color: #0b0d0f;
}
#LibraryContainer WTrackTableViewHeader,
#LibraryContainer WTrackTableViewHeader::section {
  background-color: #d8dde2;
  color: #171b1f;
  border-color: #929aa2;
  font-weight: 600;
}

/* Search, editors, BPM/transition fields. */
#LibraryContainer WSearchLineEdit,
#LibraryContainer WTrackPropertyEditor,
#LibraryContainer QLineEdit,
#LibraryContainer QPlainTextEdit,
#LibraryBPMSpinBox,
#spinBoxTransition,
#spinBoxRecentDays {
  background-color: #ffffff;
  color: #101316;
  selection-background-color: #b8d7f0;
  selection-color: #0b0d0f;
  border-color: #77828c;
}

/* Exact deck selectors override the original ivory/cyan dark-skin palette. */
#Deck1 #TitleText, #Deck1 #ArtistText, #Deck1 #BpmText, #Deck1 #KeyText,
#Deck2 #TitleText, #Deck2 #ArtistText, #Deck2 #BpmText, #Deck2 #KeyText,
#Deck3 #TitleText, #Deck3 #ArtistText, #Deck3 #BpmText, #Deck3 #KeyText,
#Deck4 #TitleText, #Deck4 #ArtistText, #Deck4 #BpmText, #Deck4 #KeyText,
#DeckCompact1 #TitleText, #DeckCompact1 #ArtistText, #DeckCompact1 #BpmText, #DeckCompact1 #KeyText,
#DeckCompact2 #TitleText, #DeckCompact2 #ArtistText, #DeckCompact2 #BpmText, #DeckCompact2 #KeyText,
#DeckCompact3 #TitleText, #DeckCompact3 #ArtistText, #DeckCompact3 #BpmText, #DeckCompact3 #KeyText,
#DeckCompact4 #TitleText, #DeckCompact4 #ArtistText, #DeckCompact4 #BpmText, #DeckCompact4 #KeyText,
#DeckMini1 #TitleTextSmall, #DeckMini1 #ArtistTextSmall, #DeckMini1 #BpmTextSmall, #DeckMini1 #KeyTextSmall,
#DeckMini2 #TitleTextSmall, #DeckMini2 #ArtistTextSmall, #DeckMini2 #BpmTextSmall, #DeckMini2 #KeyTextSmall,
#DeckMini3 #TitleTextSmall, #DeckMini3 #ArtistTextSmall, #DeckMini3 #BpmTextSmall, #DeckMini3 #KeyTextSmall,
#DeckMini4 #TitleTextSmall, #DeckMini4 #ArtistTextSmall, #DeckMini4 #BpmTextSmall, #DeckMini4 #KeyTextSmall {
  color: #111417;
}

#Deck1 #PlayPositionText, #Deck1 #DurationText,
#Deck2 #PlayPositionText, #Deck2 #DurationText,
#Deck3 #PlayPositionText, #Deck3 #DurationText,
#Deck4 #PlayPositionText, #Deck4 #DurationText,
#DeckCompact1 #PlayPositionText, #DeckCompact1 #DurationText,
#DeckCompact2 #PlayPositionText, #DeckCompact2 #DurationText,
#DeckCompact3 #PlayPositionText, #DeckCompact3 #DurationText,
#DeckCompact4 #PlayPositionText, #DeckCompact4 #DurationText,
#RateText, #RateRangePrefix, #RateRangeText,
#PreviewLabel, #PreviewTitle, #PreviewBPM {
  color: #252a2f;
}

/* Mixer / FX labels: no dark-skin grey on a light panel. */
#KnobLabel,
#FxKnobLabel,
#FxButtonLabel,
#FxUnitLabel,
#MicAuxLabel,
#MicAuxLabelUnconfigured,
#LatencyLabel {
  color: #252a2f;
}

/* Toolbar / top controls */
#ToolBar #GuiToggleButton,
#ToolBar #AiBroButton,
#ToolBar #RecDuration,
#ToolBar #BroadcastButton,
#ToolBar #SkinSettingsToggle,
#ToolBar WTime,
#ToolBar #LatencyLabel {
  color: #171b1f;
  font-size: 14px;
}
#ToolBar #GuiToggleButton[displayValue="0"],
#ToolBar #GuiToggleButton[displayValue="1"],
#ToolBar #GuiToggleButton[displayValue="2"],
#ToolBar #BroadcastButton[displayValue="0"],
#ToolBar #SkinSettingsToggle[displayValue="0"],
#ToolBar #SkinSettingsToggle[displayValue="1"] {
  color: #171b1f;
}

/* Main menu and every common popup/editor should stay light and readable. */
#MainMenu,
#MainMenu::item,
#MainMenu QMenu,
#MainMenu QMenu::item,
WTrackMenu,
WTrackMenu::item,
WTrackMenu QMenu,
WTrackMenu QMenu::item,
WCoverArtMenu,
WCoverArtMenu::item,
WCueMenuPopup,
WCueMenuPopup QLabel,
WCueMenuPopup QLineEdit,
WLibrarySidebar QMenu,
WLibrarySidebar QMenu::item,
WLibraryTextBrowser QMenu,
WLibraryTextBrowser QMenu::item,
WTrackTableViewHeader QMenu,
WTrackTableViewHeader QMenu::item,
QLineEdit QMenu,
QLineEdit QMenu::item,
QPlainTextEdit QMenu,
QPlainTextEdit QMenu::item {
  background-color: #f7f8fa;
  color: #16191d;
}
#MainMenu QMenu::item:selected,
WTrackMenu::item:selected,
WTrackMenu QMenu::item:selected,
WCoverArtMenu::item:selected,
WLibrarySidebar QMenu::item:selected,
WLibraryTextBrowser QMenu::item:selected,
WTrackTableViewHeader QMenu::item:selected,
QLineEdit QMenu::item:selected,
QPlainTextEdit QMenu::item:selected {
  background-color: #c7ddf2;
  color: #0b0d0f;
}
#MainMenu QMenu::item:disabled,
WTrackMenu QMenu::item:disabled,
WLibrarySidebar QMenu::item:disabled,
WLibraryTextBrowser QMenu::item:disabled,
QLineEdit QMenu::item:disabled,
QPlainTextEdit QMenu::item:disabled {
  color: #626971;
}

/* Larger, lighter library scrollbars are easier to see and grab by touch. */
#LibraryContainer QScrollBar {
  background-color: #e3e7ea;
  color: #30363c;
  border: 1px solid #bbc2c8;
}
#LibraryContainer QScrollBar:vertical {
  width: 20px;
}
#LibraryContainer QScrollBar:horizontal {
  height: 20px;
}
#LibraryContainer QScrollBar::handle:vertical,
#LibraryContainer QScrollBar::handle:horizontal {
  background-color: #89949e;
  min-height: 36px;
  min-width: 36px;
}

/* Skin/settings text which was intentionally dim in the original dark skin. */
#SkinSettingsLabelButton,
#CategoryLabel,
#SkinSettingsButton,
#SkinSettingsNumToggle,
#SkinSettingsNumToggleHeader,
#SkinSettingsMixerToggle,
#SkinSettingsText {
  color: #252a2f;
}


/* DJ SUGAR STREAMLINED PHONE MIXING LAYOUT
 * Keep the phone interface bright and high-contrast. The skin settings panel
 * is normally closed, but if opened it must remain readable in daylight.
 */
#SkinSettingsContainer,
#SkinSettings,
#SkinSettingsCategory,
#DeckSizeSettings,
#DeckSizeCover,
#SkinSettingsSeparator {
  background-color: #eef1f4;
  color: #171a1e;
  border-color: #b7bec6;
}

#CategoryLabel,
#SkinSettingsLabelButton,
#SkinSettingsButton,
#SkinSettingsNumToggle,
#SkinSettingsNumToggleHeader,
#SkinSettingsMixerToggle,
#SkinSettingsText {
  background-color: #eef1f4;
  color: #171a1e;
  font-size: 20px;
}

#SkinSettingsButton[displayValue="1"],
#SkinSettingsNumToggle[displayValue="1"],
#SkinSettingsNumToggleHeader[displayValue="1"] {
  background-color: #c7ddf2;
  color: #0b0d0f;
}

/* Avoid large dark empty surfaces around the waveforms and decks. */
#WaveformSplitter,
#DecksMixerContainer {
  background-color: #e4e7eb;
  color: #17191c;
}

/* Give the music browser a clear light surface and keep it visually dominant. */
#LibraryContainer,
#LibrarySingleton,
#SidebarBox,
#LibrarySplitter,
#SearchLineBox {
  background-color: #f7f8fa;
  color: #101214;
}
